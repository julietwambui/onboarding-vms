
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
 
}

model User {
   id        String   @id @default(uuid())
   name      String
   email     String    @unique
   password  String
   role      String    @default("ADMIN")
   createdAt DateTime @default(now())
  
}

model Visitor {
  id        String   @id @default(uuid())
  fullName  String
  purpose   String
  status    String   @default("PENDING") // PENDING, CHECKED_IN, CHECKED_OUT
  timeIn    DateTime?
  timeOut   DateTime?
  createdAt DateTime @default(now())
}